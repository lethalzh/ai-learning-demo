# 复制为 .env（或用 .env.local 覆盖）后填写真实值
# 后端服务监听端口
PORT=3001

# DeepSeek API Key，占位符请替换为真实 key，切勿提交到仓库
DEEPSEEK_API_KEY=your_deepseek_key_here

# DeepSeek 接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型名称
DEEPSEEK_MODEL=deepseek-chat

# 允许跨域访问的前端地址（生产环境白名单，多个用英文逗号分隔，不支持通配符）
# 开发环境（NODE_ENV != production）会自动放行 localhost / 127.0.0.1 的任意端口
CORS_ORIGINS=http://localhost:5173
